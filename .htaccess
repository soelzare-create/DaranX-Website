# DaranX — static site (Apache / cPanel)

# Default page and correct Persian encoding.
DirectoryIndex index.html
AddDefaultCharset UTF-8

# --- Canonical host: force HTTPS + www -------------------------------------
# Enable these lines AFTER SSL (AutoSSL/Let's Encrypt) is active, so every
# visitor lands on the single canonical origin https://www.daranx.com — the
# same host used in every <link rel="canonical"> tag. One redirect handles
# both http→https and non-www→www, avoiding duplicate-content for SEO.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.daranx.com%{REQUEST_URI} [R=301,L]

# --- Caching for static assets --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Self-hosted font: correct MIME type (older Apache builds may miss it).
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# --- Small hardening -------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
