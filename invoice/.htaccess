# DaranX invoicing — Apache / LiteSpeed rules.
DirectoryIndex index.php

# Never serve the database, logs or internal files directly.
<FilesMatch "\.(sqlite|sqlite3|db|log|md|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# HTTPS: the site root's .htaccess redirects every http:// or non-www request
# to https://www.daranx.com (this folder has no RewriteEngine of its own, so
# those rules apply here too). Do not add rewrite rules here without repeating it.
